generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  LECTURER
  DEPT_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

// Not a separate concept from Semester — this just labels which slot within
// an AcademicSession a given `Semester` row is. THIRD covers both trimester
// calendars (e.g. AUN-style Fall/Spring/Summer) and the common Nigerian
// "Summer/resit semester" used for carry-over students on top of the usual
// two. Nothing downstream (CourseAllocation, Registration, Result) keys off
// this enum's values — they all reference `semesterId`, so adding a value
// here is the only change needed to support a 3rd semester per session.
enum Term {
  FIRST
  SECOND
  THIRD
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  firstName    String
  middleName   String?
  lastName     String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student          Student?
  lecturer         Lecturer?
  deptAdminProfile DeptAdminProfile?
  auditLogs        AuditLog[]
  reviewedResults  Result[]           @relation("ResultReviewer")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Institutional structure
// ---------------------------------------------------------------------------

model Faculty {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]

  @@map("faculties")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  facultyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty           Faculty            @relation(fields: [facultyId], references: [id])
  programs          Program[]
  courses           Course[]
  students          Student[]
  lecturers         Lecturer[]
  deptAdminProfiles DeptAdminProfile[]

  @@index([facultyId])
  @@map("departments")
}

model Program {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  departmentId  String
  durationYears Int
  maxLevel      Int      @default(500)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  students   Student[]

  @@index([departmentId])
  @@map("programs")
}

// ---------------------------------------------------------------------------
// Role profiles (1:1 extension of User)
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(uuid())
  userId        String   @unique
  matricNumber  String   @unique
  departmentId  String
  programId     String
  level         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id])
  program      Program        @relation(fields: [programId], references: [id])
  registrations Registration[]

  @@index([departmentId])
  @@index([programId])
  @@map("students")
}

model Lecturer {
  id           String   @id @default(uuid())
  userId       String   @unique
  staffId      String   @unique
  title        String?
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department          @relation(fields: [departmentId], references: [id])
  courseAllocations  CourseAllocation[]

  @@index([departmentId])
  @@map("lecturers")
}

model DeptAdminProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("dept_admin_profiles")
}

// ---------------------------------------------------------------------------
// Academic calendar
// ---------------------------------------------------------------------------

model AcademicSession {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "2025/2026"
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters         Semester[]
  courseAllocations CourseAllocation[]

  @@map("academic_sessions")
}

model Semester {
  id        String   @id @default(uuid())
  sessionId String
  term      Term
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session           AcademicSession    @relation(fields: [sessionId], references: [id])
  courseAllocations CourseAllocation[]

  @@unique([sessionId, term])
  @@map("semesters")
}

// ---------------------------------------------------------------------------
// Courses & allocation
// ---------------------------------------------------------------------------

model Course {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  units        Int
  level        Int
  term         Term
  departmentId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department        Department          @relation(fields: [departmentId], references: [id])
  courseAllocations CourseAllocation[]

  @@index([departmentId])
  @@index([departmentId, level, term])
  @@map("courses")
}

model CourseAllocation {
  id         String   @id @default(uuid())
  courseId   String
  lecturerId String
  sessionId  String
  semesterId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course        Course          @relation(fields: [courseId], references: [id])
  lecturer      Lecturer        @relation(fields: [lecturerId], references: [id])
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  semester      Semester        @relation(fields: [semesterId], references: [id])
  registrations Registration[]

  @@unique([courseId, sessionId, semesterId])
  @@index([lecturerId])
  @@index([sessionId, semesterId])
  @@map("course_allocations")
}

// ---------------------------------------------------------------------------
// Registration & results
// ---------------------------------------------------------------------------

model Registration {
  id                 String   @id @default(uuid())
  studentId          String
  courseAllocationId String
  registeredAt       DateTime @default(now())

  student           Student          @relation(fields: [studentId], references: [id])
  courseAllocation  CourseAllocation @relation(fields: [courseAllocationId], references: [id])
  result            Result?

  @@unique([studentId, courseAllocationId])
  @@index([studentId])
  @@map("registrations")
}

model Result {
  id              String       @id @default(uuid())
  registrationId  String       @unique
  caScore         Float?
  examScore       Float?
  totalScore      Float?
  grade           String?
  gradePoint      Float?
  status          ResultStatus @default(DRAFT)
  rejectionReason String?
  reviewedById    String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id])
  reviewedBy   User?         @relation("ResultReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@map("results")
}

model GradingScale {
  id         String @id @default(uuid())
  minScore   Int
  maxScore   Int
  grade      String @unique
  gradePoint Float

  @@map("grading_scale")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
